# Copy to infra/.env (docker compose) and/or export in your shell for the services.
# Never commit real values.

# --- Infra (docker compose) ---
POSTGRES_USER=focus
POSTGRES_PASSWORD=focus
POSTGRES_PORT=5442
REDIS_PORT=6380
KAFKA_PORT=9092
KAFKA_UI_PORT=8090
ZIPKIN_PORT=9411

# --- Services ---
EUREKA_URL=http://localhost:8761/eureka
FRONTEND_ORIGIN=http://localhost:5173

# Phase 1: HS256 signing secret, at least 32 bytes
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-bytes

# Phase 2: AI providers
FOCUS_AI_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
